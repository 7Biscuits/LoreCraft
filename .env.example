# Optional: Local generation works without credentials.
# Set these on the server, then restart pnpm dev or pnpm preview.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Custom OpenAI-compatible provider (LLM_* overrides OPENAI_* when nonempty).
# Use the API root, including /v1 if the provider requires it; no endpoint suffix.
# LLM_API_KEY=your-provider-key
# LLM_BASE_URL=https://provider.example/v1
# LLM_MODEL=your-provider-model-id
# LLM_API_STYLE=chat_completions
# LLM_JSON_MODE=json_schema
# API styles: responses | chat_completions
# JSON modes: json_schema | json_object | prompt
# Local unauthenticated servers: use a dummy LLM_API_KEY, such as local.
